@page "/admin/orders"
@using WebShopMercantec.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Super Admin")]
@inject HttpClient Http

<PageTitle>Order management</PageTitle>

<div class="container mt-4">
    <h2>Order management</h2>

    @if (_loading)
    {
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    }
    else if (_error != null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover mt-3">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>User</th>
                        <th>Product</th>
                        <th>Type</th>
                        <th>Quantity</th>
                        <th>Creation date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in _orders)
                    {
                        <tr>
                            <td>@order.Id</td>
                            <td>@order.UserName</td>
                            <td>@order.ProductName</td>
                            <td>@(order.RequestableType.Contains("Asset") ? "Device" : "Accessory")</td>
                            <td>@order.Quantity</td>
                            <td>@order.CreatedAt?.ToLocalTime().ToString("g")</td>
                            <td>
                                @if (order.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (order.Status == "Fulfilled")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (order.Status == "Canceled")
                                {
                                    <span class="badge bg-danger">Canceled</span>
                                }
                                else if (order.Status == "Declined")
                                {
                                    <span class="badge bg-danger">Declined</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@order.Status</span>
                                }
                            </td>
                            <td>
                                @if (order.Status == "Pending")
                                {
                                    <button class="btn btn-sm btn-success me-1" @onclick="() => ApproveOrder(order.Id)">
                                        <i class="bi bi-check-circle"></i> Approve
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeclineOrder(order.Id)">
                                        <i class="bi bi-x-circle"></i> Decline
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        @if (_totalPages > 1)
        {
            <nav>
                <ul class="pagination">
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadOrders(_currentPage - 1)">Back</button>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">Page @_currentPage of @_totalPages</span>
                    </li>
                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadOrders(_currentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@code {
    private List<OrderDto> _orders = new();
    private bool _loading = true;
    private string? _error;
    
    private int _currentPage = 1;
    private int _pageSize = 20;
    private int _totalCount = 0;
    private int _totalPages => (int)Math.Ceiling((double)_totalCount / _pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders(1);
    }

    private async Task LoadOrders(int page)
    {
        _loading = true;
        _error = null;
        _currentPage = page;

        try
        {
            var result = await Http.GetFromJsonAsync<PagedResult<OrderDto>>($"api/orders?page={page}&pageSize={_pageSize}");
            if (result != null)
            {
                _orders = result.Items;
                _totalCount = result.TotalCount;
            }
        }
        catch (Exception ex)
        {
            _error = "Error loading orders: " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApproveOrder(int id)
    {
        try
        {
            var res = await Http.PostAsync($"api/orders/{id}/approve", null);
            if (res.IsSuccessStatusCode)
            {
                await LoadOrders(_currentPage);
            }
            else
            {
                _error = "Failed to approve order";
            }
        }
        catch (Exception ex)
        {
            _error = "Error during approval: " + ex.Message;
        }
    }

    private async Task DeclineOrder(int id)
    {
        try
        {
            var res = await Http.PostAsync($"api/orders/{id}/decline", null);
            if (res.IsSuccessStatusCode)
            {
                await LoadOrders(_currentPage);
            }
            else
            {
                _error = "Failed to decline order";
            }
        }
        catch (Exception ex)
        {
            _error = "Error during decline: " + ex.Message;
        }
    }

    private class PagedResult<T>
    {
        public List<T> Items { get; set; } = new();
        public int TotalCount { get; set; }
    }
}
