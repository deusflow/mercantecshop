@page "/admin/users"
@attribute [Authorize(Roles = "Admin,SuperAdmin")]

<PageTitle>User Management - TechShop Admin</PageTitle>

<!-- АДМИН ПАНЕЛЬ УПРАВЛЕНИЯ ПОЛЬЗОВАТЕЛЯМИ -->
<div class="admin-container fade-in">
    
    <!-- ЗАГОЛОВОК -->
    <div class="page-header">
        <h1>User Management</h1>
        <p>Manage users, credit balances, and export data.</p>
    </div>

    <!-- СТАТИСТИКА ПАНЕЛИ -->
    <div class="admin-stats grid grid-4 mb-xl">
        <div class="card stat-card-admin">
            <div class="stat-content">
                <span class="stat-label">Total Users</span>
                <span class="stat-number">248</span>
            </div>
            <div class="stat-icon">👥</div>
        </div>
        
        <div class="card stat-card-admin">
            <div class="stat-content">
                <span class="stat-label">Active Users</span>
                <span class="stat-number">231</span>
            </div>
            <div class="stat-icon">✅</div>
        </div>
        
        <div class="card stat-card-admin">
            <div class="stat-content">
                <span class="stat-label">Total Credits</span>
                <span class="stat-number">342,500</span>
            </div>
            <div class="stat-icon">💰</div>
        </div>
        
        <div class="card stat-card-admin">
            <div class="stat-content">
                <span class="stat-label">Transactions</span>
                <span class="stat-number">1,847</span>
            </div>
            <div class="stat-icon">🛒</div>
        </div>
    </div>

    <!-- ТАБЛИЦА ПОЛЬЗОВАТЕЛЕЙ -->
    <div class="card">
        <div class="flex-between mb-lg">
            <h2>All Users</h2>
            <div class="action-buttons flex gap-md">
                <input type="text" class="form-input" placeholder="Search users..." style="min-width: 300px;" />
                <button class="btn btn-secondary">Export Data</button>
                <button class="btn btn-primary">+ Add User</button>
            </div>
        </div>
        
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th class="text-right">Credits</th>
                        <th class="text-center">Purchases</th>
                        <th class="text-center">Status</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <div class="user-cell">
                                <span class="user-avatar-small">JD</span>
                                <span>John Doe</span>
                            </div>
                        </td>
                        <td>john.doe@mercantec.dk</td>
                        <td class="text-right font-weight-bold">1,250</td>
                        <td class="text-center">12</td>
                        <td class="text-center"><span class="badge badge-success">Active</span></td>
                        <td class="text-right">
                            <div class="action-buttons-table">
                                <button class="btn-icon" title="Add Credits">💰</button>
                                <button class="btn-icon" title="View Details">👁️</button>
                            </div>
                        </td>
                    </tr>
                    
                    <tr>
                        <td>
                            <div class="user-cell">
                                <span class="user-avatar-small">JS</span>
                                <span>Jane Smith</span>
                            </div>
                        </td>
                        <td>jane.smith@mercantec.dk</td>
                        <td class="text-right font-weight-bold">2,450</td>
                        <td class="text-center">8</td>
                        <td class="text-center"><span class="badge badge-success">Active</span></td>
                        <td class="text-right">
                            <div class="action-buttons-table">
                                <button class="btn-icon" title="Add Credits">💰</button>
                                <button class="btn-icon" title="View Details">👁️</button>
                            </div>
                        </td>
                    </tr>
                    
                    <tr>
                        <td>
                            <div class="user-cell">
                                <span class="user-avatar-small">MJ</span>
                                <span>Mike Johnson</span>
                            </div>
                        </td>
                        <td>mike.johnson@mercantec.dk</td>
                        <td class="text-right font-weight-bold">350</td>
                        <td class="text-center">15</td>
                        <td class="text-center"><span class="badge badge-success">Active</span></td>
                        <td class="text-right">
                            <div class="action-buttons-table">
                                <button class="btn-icon" title="Add Credits">💰</button>
                                <button class="btn-icon" title="View Details">👁️</button>
                            </div>
                        </td>
                    </tr>
                    
                    <tr>
                        <td>
                            <div class="user-cell">
                                <span class="user-avatar-small">SW</span>
                                <span>Sarah Williams</span>
                            </div>
                        </td>
                        <td>sarah.williams@mercantec.dk</td>
                        <td class="text-right font-weight-bold">5,120</td>
                        <td class="text-center">3</td>
                        <td class="text-center"><span class="badge badge-success">Active</span></td>
                        <td class="text-right">
                            <div class="action-buttons-table">
                                <button class="btn-icon" title="Add Credits">💰</button>
                                <button class="btn-icon" title="View Details">👁️</button>
                            </div>
                        </td>
                    </tr>
                    
                    <tr>
                        <td>
                            <div class="user-cell">
                                <span class="user-avatar-small">TA</span>
                                <span>Tom Anderson</span>
                            </div>
                        </td>
                        <td>tom.anderson@mercantec.dk</td>
                        <td class="text-right font-weight-bold">0</td>
                        <td class="text-center">22</td>
                        <td class="text-center"><span class="badge badge-warning">Inactive</span></td>
                        <td class="text-right">
                            <div class="action-buttons-table">
                                <button class="btn-icon" title="Add Credits">💰</button>
                                <button class="btn-icon" title="View Details">👁️</button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Пагинация -->
        <div class="pagination">
            <button class="btn btn-secondary btn-small">Previous</button>
            <span class="pagination-info">Page 1 of 25</span>
            <button class="btn btn-secondary btn-small">Next</button>
        </div>
    </div>

</div>

