@page "/login"
@inject APIService api
@inject NavigationManager Nav

<PageTitle>Login - TechShop</PageTitle>

<!-- КОНТЕЙНЕР ДЛЯ ФОРМЫ ВХОДА -->
<div class="login-container fade-in">
    <div class="login-card card">
        
        <!-- ЗАГОЛОВОК ФОРМЫ -->
        <div class="login-header">
            <h2>Sign In</h2>
            <p>Enter your credentials to access the shop.</p>
        </div>

        @if (showMessage)
        {
            <div class="error-box" style="color:red;">
                ❌ @errorMessage
            </div>
        }

        <!-- ФОРМА ВХОДА -->
        <EditForm model="user" method="post" OnValidSubmit="() => HandleSubmit()" FormName="LoginForm"class="login-form">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <!-- Поле Email -->
            <div class="form-group">
                <label class="form-label" for="email">E-mail:</label>
                <InputText @bind-Value="user.Username" id="email" type="email" class="form-input" placeholder="your.email@mercantec.dk" />
                <ValidationMessage For="@(() => user.Username)" />
            </div>

            <!-- Поле Password -->
            <div class="form-group">
                <label class="form-label" for="password">Password:</label>
                <InputText @bind-Value="user.Password" id="password" type="password" class="form-input" placeholder="Enter your password" />
                <ValidationMessage For="@(() => user.Password)" />
            </div>

            <!-- Чекбокс "Remember Me" и "Забыл пароль" -->
            <div class="form-group flex-between">
                <label class="checkbox-label">
                    <input type="checkbox" />
                    <span>Remember me</span>
                </label>
                <a href="/forgot-password" class="link-secondary">Forgot password?</a>
            </div>

            <!-- Кнопка входа -->
            <button type="submit" class="btn btn-primary btn-large" style="width: 100%;">
                Sign In
            </button>

        </EditForm>

        <!-- ДОПОЛНИТЕЛЬНЫЕ ОПЦИИ -->
        <div class="login-footer">
            <p class="text-secondary">
                Don't have an account? <a href="/register" class="link-accent">Contact an administrator</a>
            </p>
        </div>

    </div>
</div>

@code {
    private LoginDto user = new LoginDto();
    string errorMessage = "Incorrect login or password. Please try again.";
    bool showMessage = false;

    private async Task HandleSubmit()
    {
        showMessage = false;

        bool success = await api.Login(user);
        if (success)
        {
            Nav.NavigateTo("/", forceLoad: true);
        }
        else
        {
            showMessage = true;
        }
    }
}

