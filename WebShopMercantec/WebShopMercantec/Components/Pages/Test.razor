@page "/test"
@inject SnipeItContext context

<h3>test</h3>

@foreach(var u in users)
{
    <p>@u.Username</p>
}

@code {
    List<UserDto> users = new List<UserDto>();

    protected override async Task OnInitializedAsync()
    {
        users = await context.Users
            .Take(20)
            .Select(u => new UserDto
            {
                Username = u.Username
            })
            .ToListAsync();
    }
}
