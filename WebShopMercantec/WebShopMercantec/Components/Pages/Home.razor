@page "/"
@inject IProductService productService
<PageTitle>Catalog - TechShop</PageTitle>

<!-- ЗАГОЛОВОК СТРАНИЦЫ -->
<div class="page-header text-center fade-in">
    <h1>Find Your Next Gear</h1>
    <p class="mx-auto">The best equipment, available for you. Powered by credits.</p>
</div>

<!-- ФИЛЬТРЫ И ПОИСК -->
<div class="filters-section mb-xl fade-in delay-1">
    <div class="flex-center gap-lg">
        <div class="search-box">
            <input type="text" class="form-input" placeholder="Search for a MacBook, monitor, etc." style="min-width: 400px;" />
        </div>
        <div class="filter-buttons flex gap-md">
            <button class="btn btn-secondary">All</button>
            <button class="btn btn-secondary">Laptops</button>
            <button class="btn btn-secondary">Monitors</button>
            <button class="btn btn-secondary">Accessories</button>
        </div>
    </div>
</div>

<!-- КАТАЛОГ ПРОДУКТОВ (СЕТКА КАРТОЧЕК) -->
<div class="grid grid-4">
    
    <!-- КАРТОЧКА ПРОДУКТА -->
    @if(products != null) {
        @foreach(var p in products) {
             <div class="card product-card fade-in-item delay-1">
                    <div class="product-image">
                        <div class="placeholder-image"><img src="@p.Image"></div>
                    </div>
                    <div class="product-info">
                        <h3 class="product-title">@p.Name</h3>
                        <div class="flex-between mt-lg">
                            <span class="product-price">@p.PurchaseCost Credits</span>
                            <div class="avaliabilty">@(p.IsAvailable ? "Avaliable" : "Not avaliable")</div>
                            <a href="@($"/product/{p.Id}")" class="btn btn-primary btn-small">View</a>
                        </div>
                    </div>
                </div>
        }
    } else {
        <p>Loading...</p>
    }

</div>

@code {
    List<ProductDto> products = new List<ProductDto>();

    protected override async Task OnInitializedAsync()
    {
        //TODO: make sure it returns any products at all and change to using API
        products = (await productService.GetAvailableProductsAsync()).ToList();
    }
}
